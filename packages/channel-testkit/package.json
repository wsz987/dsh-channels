{
  "name": "@wsz987/channel-testkit",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wsz987/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Contract tests, fake adapter/upstream/harness, fixtures and E2E helpers for channel adapters",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fixture-loader": {
      "types": "./lib/fixture-loader.d.ts",
      "default": "./lib/fixture-loader.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@wsz987/channel-core": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "rimraf": "^6.0.0"
  },
  "license": "MIT"
}
