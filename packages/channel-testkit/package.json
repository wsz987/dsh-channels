{
  "name": "@dsh/channel-testkit",
  "version": "0.2.0",
  "description": "Contract tests, fake adapter/upstream/harness, fixtures and E2E helpers for channel adapters",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@dsh/channel-core": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "rimraf": "^6.0.0"
  },
  "license": "MIT"
}
