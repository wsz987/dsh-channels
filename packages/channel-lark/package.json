{
  "name": "@wsz987/channel-lark",
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsz987/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Lark / Feishu channel adapter for DeepSeek Harness (threads, editable card streaming, edit strategy)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@wsz987/channel-core": "workspace:*",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@wsz987/channel-control": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@wsz987/channel-testkit": "workspace:*",
    "rimraf": "^6.0.0"
  },
  "license": "MIT"
}
