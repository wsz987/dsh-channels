{
  "name": "@wsz987/channel-telegram",
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsz987/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Telegram Bot API channel adapter for DeepSeek Harness (credentials seam, control-plane definition, edit streaming, file hydration)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@grammyjs/types": "4.0.0",
    "@wsz987/channel-control": "workspace:*",
    "@wsz987/channel-core": "workspace:*",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@wsz987/channel-testkit": "workspace:*",
    "rimraf": "^6.0.0"
  },
  "license": "MIT"
}
