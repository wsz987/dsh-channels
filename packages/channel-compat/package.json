{
  "name": "@wsz987/channel-compat",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsz987/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Upstream compatibility manifests, version policy and channels doctor",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:fixtures": "vitest run test/fixtures-sweep.test.ts",
    "check:manifests": "vitest run test/manifest-governance.test.ts",
    "doctor": "vitest run test/doctor-all.test.ts",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@wsz987/channel-core": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@wsz987/channel-testkit": "workspace:*",
    "rimraf": "^6.0.0"
  },
  "license": "MIT"
}
