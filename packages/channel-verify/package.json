{
  "name": "@wsz987/channel-verify",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsz987/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Offline verification CLI for third-party DeepSeek Harness channel adapters (dsh channels verify)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-channels-verify": "./lib/cli.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "node lib/cli.js",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@wsz987/channel-core": "workspace:*",
    "@wsz987/channel-testkit": "workspace:*",
    "@wsz987/channel-compat": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "rimraf": "^6.0.0"
  },
  "license": "MIT"
}
