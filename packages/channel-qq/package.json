{
  "name": "@dsh/channel-qq",
  "version": "0.5.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/wsz987/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "QQ channel adapter for DeepSeek Harness (buffered streaming, dm/group, QR auth)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@dsh/channel-core": "workspace:*",
    "ws": "^8"
  },
  "devDependencies": {
    "@dsh/channel-testkit": "workspace:*",
    "@types/ws": "^8",
    "rimraf": "^6.0.0"
  },
  "license": "MIT"
}
