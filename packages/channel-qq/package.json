{
  "name": "@wsz987/channel-qq",
  "version": "0.3.0-beta.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsz987/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "QQ channel adapter for DeepSeek Harness (Tencent official SDK, native C2C streaming + buffered group)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@wsz987/channel-core": "workspace:*",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "@wsz987/channel-control": "workspace:*"
  },
  "devDependencies": {
    "@wsz987/channel-testkit": "workspace:*",
    "rimraf": "^6.0.0"
  },
  "license": "MIT"
}
