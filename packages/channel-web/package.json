{
  "name": "@wsz987/channel-web",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsz987/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "DeepSeek Harness Web client: Settings > Channels (渠道) dashboard",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.host.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@wsz987/channel-core": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "qrcode": "^1.5.4",
    "@wsz987/channel-control": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
